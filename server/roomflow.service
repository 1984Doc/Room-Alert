[Unit]
Description=RoomFlow Oscar room turnover notifier
After=network-online.target
Wants=network-online.target

[Service]
# Edit these three lines to match your install (see README, step 2).
# Example for your own account:
#   User=youruser
#   WorkingDirectory=/home/youruser/work/roomflow/server
#   ExecStart=/home/youruser/work/roomflow/venv/bin/python app.py
User=roomflow
WorkingDirectory=/opt/roomflow/server
ExecStart=/opt/roomflow/venv/bin/python app.py

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
